# Postgres. Supabase, Neon or a local instance all work.
DATABASE_URL="postgresql://user:password@localhost:5432/printshop"

# The Python worker (services/worker). Start it with: pnpm worker
WORKER_URL="http://localhost:8000"

# Stripe. Test keys until you go live.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Operator access. A single shared secret is enough for one operator; swap for real auth
# before anyone else gets a login.
ADMIN_TOKEN="change-me"

# Shop agent (phase 3). One token per agent, revocable.
AGENT_TOKEN="change-me-too"

# Etsy API v3. Create an app at https://www.etsy.com/developers/your-apps
ETSY_API_KEY=""
ETSY_ACCESS_TOKEN=""
ETSY_SHOP_ID=""
